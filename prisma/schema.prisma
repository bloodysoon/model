generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Model {
  id          String   @id @default(cuid())
  name        String
  avatarUrl   String
  videoEmbedUrl String?
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]
}

model Video {
  id          String   @id @default(cuid())
  title       String
  embedUrl    String
  thumbnailUrl String?
  order       Int
  createdAt   DateTime @default(now())
  modelId     String
  model       Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}
